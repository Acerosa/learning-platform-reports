{
  "name": "learning-platform-reports",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone learner Reports SPA for completed lesson/session performance reports.",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
