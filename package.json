    "test:regression": "node --test tests/*.test.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@learning-platform/results": "file:../learning-platform-results",
    "@supabase/supabase-js": "2.112.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
